diff --git a/repro.py b/repro.py
new file mode 100644
index 000000000..6502a62d4
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,61 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/test")
+async def test(my_header: str = Header()):
+    return {"my_header": my_header}
+
+@app.get("/test-false")
+async def test_false(my_header: str = Header(convert_underscores=False)):
+    return {"my_header": my_header}
+
+@app.get("/test-alias-diff")
+async def test_alias_diff(my_header: str = Header(alias="some_other_header")):
+    return {"my_header": my_header}
+
+client = TestClient(app)
+
+def test_convert_underscores_true():
+    # Default is convert_underscores=True
+    # Should accept my-header
+    response = client.get("/test", headers={"my-header": "value1"})
+    assert response.json() == {"my_header": "value1"}
+    
+    # Should NOT accept my_header
+    response = client.get("/test", headers={"my_header": "value2"})
+    assert response.status_code == 422
+
+def test_convert_underscores_false():
+    # Should accept my_header
+    response = client.get("/test-false", headers={"my_header": "value3"})
+    assert response.json() == {"my_header": "value3"}
+    
+    # Should NOT accept my-header
+    response = client.get("/test-false", headers={"my-header": "value4"})
+    assert response.status_code == 422
+
+def test_alias_diff():
+    # Default is convert_underscores=True
+    # alias is "some_other_header", field.name is "my_header"
+    # alias != field.name, so it should NOT be converted to hyphen
+    # It should accept "some_other_header"
+    response = client.get("/test-alias-diff", headers={"some_other_header": "value5"})
+    assert response.json() == {"my_header": "value5"}
+    
+    # It should NOT accept "some-other-header"
+    response = client.get("/test-alias-diff", headers={"some-other-header": "value6"})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_convert_underscores_true()
+        print("test_convert_underscores_true passed")
+        test_convert_underscores_false()
+        print("test_convert_underscores_false passed")
+        test_alias_diff()
+        print("test_alias_diff passed")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 000000000..1060252af
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,37 @@
+from fastapi import FastAPI, Header, Request
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.get("/headers")
+async def read_headers(my_header: str = Header(alias="my_header")):
+    return {"my_header": my_header}
+
+client = TestClient(app)
+
+def test_header_with_underscore_alias_rejected():
+    # When convert_underscores=True (default), headers with underscores should be rejected
+    # even if an alias with underscores is provided.
+    # The client should send 'my-header' and it should be accepted.
+    # The client should send 'my_header' and it should be rejected (422 Unprocessable Entity).
+    
+    # Test accepted (hyphenated)
+    response = client.get("/headers", headers={"my-header": "value"})
+    print(f"Hyphenated header response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"my_header": "value"}
+
+    # Test rejected (underscore)
+    response = client.get("/headers", headers={"my_header": "value"})
+    print(f"Underscore header response: {response.status_code}, {response.json()}")
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_header_with_underscore_alias_rejected()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
