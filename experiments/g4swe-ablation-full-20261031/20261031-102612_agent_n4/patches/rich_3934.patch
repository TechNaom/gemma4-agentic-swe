@@ -0,0 +1,12 @@
+from rich.console import Console
+from rich.live import Live
+import time
+
+console = Console()
+
+with Live("", refresh_per_second=4) as live:
+    for i in range(3):
+        console.print(f"Printing line {i}")
+        time.sleep(0.1)
+    live.update("Now I have content!")
+    time.sleep(0.1)
