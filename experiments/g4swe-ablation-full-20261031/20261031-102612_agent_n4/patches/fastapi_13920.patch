+def is_typealiastype(annotation: Any) -> bool:
+    type_alias_types = []
+    try:
+        from typing import TypeAliasType
+        type_alias_types.append(TypeAliasType)
+    except ImportError:
+        pass
+
+    try:
+        from typing_extensions import TypeAliasType
+        type_alias_types.append(TypeAliasType)
+    except ImportError:
+        pass
+
+    if not type_alias_types:
+        return False
+
+    return isinstance(annotation, tuple(type_alias_types))
+
