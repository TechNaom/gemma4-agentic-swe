 from fastapi.types import UnionType
-from pydantic import BaseModel
+from pydantic import BaseModel, Json
 from pydantic.version import VERSION as PYDANTIC_VERSION
 from starlette.datastructures import UploadFile
 from typing_extensions import get_args, get_origin
@@ -103,6 +103,19 @@ def field_annotation_is_complex(annotation: Union[type[Any], None]) -> bool:
     )
 
 
+def field_annotation_is_json(annotation: Union[type[Any], None], metadata: Any = None) -> bool:
+    if metadata is not None:
+        for m in metadata:
+            if isinstance(m, Json):
+                return True
+    origin = get_origin(annotation)
+    if origin is Annotated:
+        for arg in get_args(annotation):
+            if isinstance(arg, Json):
+                return True
+    return False
+
+
 def field_annotation_is_scalar(annotation: Any) -> bool:
     # handle Ellipsis here to make tuple[int, ...] work nicely
     return annotation is Ellipsis or not field_annotation_is_complex(annotation)
