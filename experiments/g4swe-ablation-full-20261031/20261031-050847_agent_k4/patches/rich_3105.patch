+from rich.segment import Segment
+from rich.cells import cell_len
+
+def test_split():
+    test_cases = [
+        ("A", 0),
+        ("A", 1),
+        ("💩", 0),
+        ("💩", 1),
+        ("💩", 2),
+        ("A💩", 0),
+        ("A💩", 1),
+        ("A💩", 2),
+        ("A💩", 3),
+        ("💩A", 0),
+        ("💩A", 1),
+        ("💩A", 2),
+        ("💩A", 3),
+        ("💩💩", 0),
+        ("💩💩", 1),
+        ("💩💩", 2),
+        ("💩💩", 3),
+        ("💩💩", 4),
+        ("\u200BA", 0),
+        ("\u200BA", 1),
+        ("A\u200B", 0),
+        ("A\u200B", 1),
+        ("\u200B\u200B", 0),
+    ]
+    
+    for text, cut in test_cases:
+        try:
+            s = Segment(text)
+            res = s.split_cells(cut)
+            len1 = res[0].cell_length
+            len2 = res[1].cell_length
+            total = len1 + len2
+            expected = cell_len(text)
+            if total != expected:
+                print(f"FAIL: text={repr(text)}, cut={cut}, total={total}, expected={expected}")
+            else:
+                print(f"PASS: text={repr(text)}, cut={cut}")
+        except Exception as e:
+            print(f"ERROR: text={repr(text)}, cut={cut}, error={e}")
+
+if __name__ == "__main__":
+    test_split()
