+import unicodedata
+from rich.cells import cell_len, set_cell_size, chop_cells, split_graphemes
+
+def test_split_graphemes():
+    print("Testing split_graphemes...")
+    test_cases = [
+        ("hello", ["h", "e", "l", "l", "o"]),
+        ("a\u0301", ["a\u0301"]), # combining mark
+        ("👨‍👩‍👧‍👦", ["👨‍👩‍👧‍👦"]), # ZWJ sequence
+        ("a\u200d b", ["a\u200d", " ", "b"]), # ZWJ
+        ("a\ufe0f", ["a\ufe0f"]), # variation selector
+    ]
+    for text, expected in test_cases:
+        result = split_graphemes(text)
+        print(f"Text: {text!r}, Expected: {expected!r}, Result: {result!r}")
+        assert result == expected
+
+def test_set_cell_size():
+    print("\nTesting set_cell_size...")
+    test_cases = [
+        ("hello", 3, "hel"),
+        ("hello", 7, "hello  "),
+        ("a\u0301", 1, "a\u0301"), # combining mark, width 1
+        ("a\u0301", 0, ""),
+        ("👨‍👩‍👧‍👦", 2, "👨‍👩‍👧‍👦"), # ZWJ sequence, width 2
+        ("👨‍👩‍👧‍👦", 1, " "), # ZWJ sequence, width 2, total 1 -> should return space
+    ]
+    for text, total, expected in test_cases:
+        result = set_cell_size(text, total)
+        print(f"Text: {text!r}, Total: {total}, Expected: {expected!r}, Result: {result!r}")
+        assert result == expected
+
+def test_chop_cells():
+    print("\nTesting chop_cells...")
+    test_cases = [
+        ("hello", 3, ["hel", "lo"]),
+        ("a\u0301b", 1, ["a\u0301", "b"]), # combining mark, width 1
+        ("👨‍👩‍👧‍👦", 1, ["👨‍👩‍👧‍👦"]), # ZWJ sequence, width 2, width 1 -> should not split
+        # Wait, if width is 1 and grapheme is 2, it should still be on its own line.
+        # Let's check the implementation of chop_cells.
+    ]
+    for text, width, expected in test_cases:
+        result = chop_cells(text, width)
+        print(f"Text: {text!r}, Width: {width}, Expected: {expected!r}, Result: {result!r}")
+        assert result == expected
+
+if __name__ == "__main__":
+    try:
+        test_split_graphemes()
+        test_set_cell_size()
+        test_chop_cells()
+        print("\nAll tests passed!")
+    except AssertionError as e:
+        print(f"\nTest failed!")
+        raise e
