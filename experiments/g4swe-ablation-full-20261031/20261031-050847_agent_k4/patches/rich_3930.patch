+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of graphemes.
+
+    Args:
+        text (str): The text to split.
+
+    Returns:
+        list[str]: A list of graphemes.
+    """
+    graphemes = []
+    for char in text:
+        if not graphemes:
+            graphemes.append(char)
+            continue
+
+        prev_char = graphemes[-1][-1]
+        if (
+            unicodedata.combining(char)
+            or char == "\u200d"
+            or 0xfe00 <= ord(char) <= 0xfe0f
+            or prev_char == "\u200d"
+        ):
+            graphemes[-1] += char
+        else:
+            graphemes.append(char)
+    return graphemes
+
