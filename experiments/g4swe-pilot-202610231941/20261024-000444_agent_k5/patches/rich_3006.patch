@@ -0,0 +1,16 @@
+import inspect
+from rich.repr import auto
+
+class CustomDefault:
+    def __eq__(self, other):
+        return True
+
+@auto
+class Foo:
+    def __init__(self, x, y=CustomDefault()):
+        self.x = x
+        self.y = y
+
+foo = Foo(1)
+foo.y = "something else"
+print(repr(foo))
