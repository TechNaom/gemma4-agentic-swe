@@ -0,0 +1,33 @@
+import os
+from rich.console import Console
+
+def test_broken_pipe():
+    # Create a pipe
+    r, w = os.pipe()
+    
+    # Create a console that writes to the write end of the pipe
+    # We need to wrap the file descriptor in a file-like object
+    import io
+    f = os.fdopen(w, 'w')
+    console = Console(file=f)
+    
+    # Close the read end of the pipe immediately
+    os.close(r)
+    
+    # Now try to write to the console. 
+    # This should trigger a BrokenPipeError eventually.
+    print("Writing to console...")
+    try:
+        for i in range(1000):
+            console.print("A" * 1000000) # Write 1MB per line
+        print("Successfully wrote all lines")
+    except BrokenPipeError:
+        print("Caught BrokenPipeError (unexpectedly - should be handled by rich)")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+    
+    print(f"Console broken pipe status: {console._broken_pipe}")
+    print("Test finished.")
+
+if __name__ == "__main__":
+    test_broken_pipe()
