+
+app = FastAPI()
+
+@app.get("/test", status_code=204)
+def test_route() -> "None":
+    return None
+
+client = TestClient(app)
+
+def test_none_return_type():
+    response = client.get("/test")
+    assert response.status_code == 204
+    assert response.text == ""
