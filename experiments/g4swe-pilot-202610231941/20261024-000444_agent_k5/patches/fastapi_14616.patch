@@ -0,0 +1,26 @@
+from typing import Annotated
+from pydantic import BaseModel, Json
+from dataclasses import dataclass
+
+@dataclass
+class ModelField:
+    field_info: any
+
+@dataclass
+class FieldInfo:
+    metadata: list
+    annotation: any
+
+def is_sequence_field(field: ModelField) -> bool:
+    if any(m is Json or isinstance(m, Json) for m in getattr(field.field_info, "metadata", [])):
+        return False
+    return False # simplified for test
+
+class MyModel1(BaseModel):
+    items: Json[list[str]]
+
+model1 = MyModel1
+field_info1 = model1.model_fields["items"]
+field = ModelField(field_info=field_info1)
+
+print(f"is_sequence_field: {is_sequence_field(field)}")
