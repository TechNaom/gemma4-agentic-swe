diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..dfde1d2c
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,22 @@
+from rich.style import Style
+
+def test_clear_meta_hash():
+    style = Style(color="red", meta={"key": "value"})
+    hash_original = hash(style)
+    
+    style_cleared = style.clear_meta_and_links()
+    hash_cleared = hash(style_cleared)
+    
+    print(f"Original hash: {hash_original}")
+    print(f"Cleared hash: {hash_cleared}")
+    
+    assert hash_original != hash_cleared, "Hash should change after clearing meta"
+    print("Test passed!")
+
+if __name__ == "__main__":
+    try:
+        test_clear_meta_hash()
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
