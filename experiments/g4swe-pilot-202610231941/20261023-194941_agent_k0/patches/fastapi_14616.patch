new file mode 100644
index 00000000..03349230
--- /dev/null
+++ b/check_json_types.py
@@ -0,0 +1,12 @@
+from pydantic import BaseModel, Field, Json
+from typing import List, Set, Tuple
+
+class TestModel(BaseModel):
+    list_json: Json[List[str]] = Field(default=[])
+    set_json: Json[Set[str]] = Field(default=set())
+    tuple_json: Json[Tuple[str, ...]] = Field(default=())
+    scalar_json: Json[int] = Field(default=0)
+
+for name, field_name in [("list_json", "list_json"), ("set_json", "set_json"), ("tuple_json", "tuple_json"), ("scalar_json", "scalar_json")]:
+    field_info = TestModel.model_fields[field_name]
+    print(f"{name}: metadata={getattr(field_info, 'metadata', 'No metadata')}")
