--- /dev/null
+++ b/repro_debug.py
@@ -0,0 +1,15 @@
+import rich.repr
+
+class EqualToEmpty:
+    def __eq__(self, other):
+        return True
+    def __repr__(self):
+        return "EqualToEmpty()"
+
+@rich.repr.auto
+class EqualToEmptyEgg:
+    def __init__(self, foo: str, bar=EqualToEmpty()):
+        self.foo = foo
+        self.bar = bar
+
+print(f"Repr: {repr(EqualToEmptyEgg('hello'))}")
