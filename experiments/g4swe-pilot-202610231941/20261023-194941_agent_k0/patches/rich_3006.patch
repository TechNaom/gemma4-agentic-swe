diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..bf30406f
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,20 @@
+import inspect
+from rich.repr import auto
+
+class EqualToEmpty:
+    def __eq__(self, other):
+        return True
+
+@auto
+class EqualToEmptyEgg:
+    def __init__(self, foo: str, bar=EqualToEmpty()):
+        self.foo = foo
+        self.bar = bar
+
+egg = EqualToEmptyEgg("hello")
+r = repr(egg)
+print(f"repr: {r}")
+
+# Let's see what auto_rich_repr yields
+for arg in egg.__rich_repr__():
+    print(f"arg: {arg}")
diff --git a/repro_debug.py b/repro_debug.py
new file mode 100644
