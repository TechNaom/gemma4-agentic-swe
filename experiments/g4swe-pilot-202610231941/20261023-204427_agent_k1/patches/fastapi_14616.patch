new file mode 100644
index 00000000..d06d4500
--- /dev/null
+++ b/repro_debug.py
@@ -0,0 +1,32 @@
+from fastapi import FastAPI, Form
+from pydantic import Json
+from typing import List
+from fastapi.dependencies.utils import is_sequence_field
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Json[List[str]] = Form(...)):
+    return {"data": data}
+
+# Find the field for 'data'
+for route in app.routes:
+    if hasattr(route, "endpoint"):
+        import inspect
+        sig = inspect.signature(route.endpoint)
+        for name, param in sig.parameters.items():
+            if name == "data":
+                # This is a bit hacky, but let's try to find the ModelField
+                # In a real request, FastAPI creates these.
+                # Let's see if we can find it in the route's dependencies.
+                print(f"Param: {name}, Default: {param.default}")
+
+# Let's try to reproduce the is_sequence_field call directly
+from fastapi._compat.v2 import ModelField
+from pydantic.fields import FieldInfo
+from fastapi import params
+
+field_info = FieldInfo(annotation=Json[List[str]], default=params.Form(...))
+field = ModelField(field_info=field_info, name="data")
+print(f"is_sequence_field: {is_sequence_field(field)}")
+print(f"annotation: {field.field_info.annotation}")
