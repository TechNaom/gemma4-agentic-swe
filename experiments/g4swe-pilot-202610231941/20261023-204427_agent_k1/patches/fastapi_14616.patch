diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..d67fcafe
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import Json
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Json[List[str]] = Form(...)):
+    return {"data": data}
+
+client = TestClient(app)
+
+def test_json_form():
+    # This should work: data is a JSON string '["a", "b"]'
+    # FastAPI should use .get() to get '["a", "b"]', then Pydantic should parse it as List[str]
+    response = client.post("/test", data={"data": '["a", "b"]'})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"data": ["a", "b"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
