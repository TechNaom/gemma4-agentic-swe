@@ -0,0 +1,26 @@
+
+import io
+from rich.console import Console
+from rich.progress import Progress
+
+def test_progress_disabled_no_newline():
+    buffer = io.StringIO()
+    console = Console(file=buffer, force_terminal=False)
+    print(f"Console is_interactive: {console.is_interactive}")
+    print(f"Console is_jupyter: {console.is_jupyter}")
+    
+    # Create Progress with disable=True
+    with Progress(console=console, disable=True) as progress:
+        progress.add_task("Task 1")
+        progress.update(0, advance=1)
+    
+    output = buffer.getvalue()
+    print(f"Output: {repr(output)}")
+    assert output == "", f"Expected empty output, got {repr(output)}"
+
+if __name__ == "__main__":
+    try:
+        test_progress_disabled_no_newline()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
