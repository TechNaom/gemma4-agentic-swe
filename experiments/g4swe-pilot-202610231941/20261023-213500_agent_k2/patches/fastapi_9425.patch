diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..588b283e
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,32 @@
+
+from fastapi.dependencies.utils import get_typed_return_annotation
+
+def test_get_typed_return_annotation():
+    def func() -> "None":
+        return None
+    
+    result = get_typed_return_annotation(func)
+    print(f"Result for -> 'None': {result} (type: {type(result)})")
+    assert result is None
+
+    def func_none() -> None:
+        return None
+    
+    result_none = get_typed_return_annotation(func_none)
+    print(f"Result for -> None: {result_none} (type: {type(result_none)})")
+    assert result_none is None
+
+    def func_empty():
+        return None
+    
+    result_empty = get_typed_return_annotation(func_empty)
+    print(f"Result for no annotation: {result_empty} (type: {type(result_empty)})")
+    assert result_empty is None
+
+if __name__ == "__main__":
+    try:
+        test_get_typed_return_annotation()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed!")
+        raise e
