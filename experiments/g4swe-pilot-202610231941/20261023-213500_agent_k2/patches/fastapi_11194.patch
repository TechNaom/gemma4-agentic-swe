+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+from typing import Optional
+
+app = FastAPI()
+
+@app.post("/test-order-1")
+async def test_order_1(
+    file: Optional[UploadFile] = File(None),
+    form_data: str = Form(...),
+):
+    return {"file": file.filename if file else None, "form_data": form_data}
+
+@app.post("/test-order-2")
+async def test_order_2(
+    form_data: str = Form(...),
+    file: Optional[UploadFile] = File(None),
+):
+    return {"file": file.filename if file else None, "form_data": form_data}
+
+client = TestClient(app)
+
+def test_order_1():
+    response = client.post(
+        "/test-order-1",
+        data={"form_data": "test"},
+        files={"file": ("test.txt", b"content")}
+    )
+    print(f"test_order_1 response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"file": "test.txt", "form_data": "test"}
+
+def test_order_2():
+    response = client.post(
+        "/test-order-2",
+        data={"form_data": "test"},
+        files={"file": ("test.txt", b"content")}
+    )
+    print(f"test_order_2 response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"file": "test.txt", "form_data": "test"}
+
+if __name__ == "__main__":
+    try:
+        test_order_1()
+        print("test_order_1 passed")
+        test_order_2()
+        print("test_order_2 passed")
+    except Exception as e:
+        print(f"Error: {e}")
+        import traceback
+        traceback.print_exc()
