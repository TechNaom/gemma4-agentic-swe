@@ -0,0 +1,48 @@
+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test-multiple")
+async def test_multiple(
+    form_data: str = Form(...), 
+    files: List[UploadFile] = File(...)
+):
+    return {"form_data": form_data, "files": [f.filename for f in files]}
+
+@app.post("/test-multiple-reversed")
+async def test_multiple_reversed(
+    files: List[UploadFile] = File(...), 
+    form_data: str = Form(...)
+):
+    return {"form_data": form_data, "files": [f.filename for f in files]}
+
+client = TestClient(app)
+
+def test_multiple_form_before_files():
+    files = [("files", ("file1", b"content1")), ("files", ("file2", b"content2"))]
+    data = {"form_data": "some data"}
+    response = client.post("/test-multiple", data=data, files=files)
+    print(f"Response: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 200
+
+def test_multiple_files_before_form():
+    files = [("files", ("file1", b"content1")), ("files", ("file2", b"content2"))]
+    data = {"form_data": "some data"}
+    response = client.post("/test-multiple-reversed", data=data, files=files)
+    print(f"Response: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_multiple_form_before_files()
+        print("test_multiple_form_before_files passed")
+    except Exception as e:
+        print(f"test_multiple_form_before_files failed: {e}")
+
+    try:
+        test_multiple_files_before_form()
+        print("test_multiple_files_before_form passed")
+    except Exception as e:
+        print(f"test_multiple_files_before_form failed: {e}")
