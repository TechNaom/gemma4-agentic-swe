@@ -0,0 +1,31 @@
+import pytest
+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test-mixed")
+async def test_mixed(
+    name: str = Form(...),
+    files: List[UploadFile] = File(...)
+):
+    content = []
+    for f in files:
+        content.append((await f.read()).decode())
+    return {"name": name, "files": content}
+
+client = TestClient(app)
+
+def test_mixed_form_first():
+    # Form before File
+    response = client.post(
+        "/test-mixed",
+        data={"name": "test"},
+        files=[("files", ("file1.txt", b"file1")), ("files", ("file2.txt", b"file2"))]
+    )
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    test_mixed_form_first()
