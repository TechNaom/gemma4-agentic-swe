@@ -0,0 +1,30 @@
+
+from fastapi import FastAPI, File, Form
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/upload")
+async def upload(form_data: str = Form(...), file: bytes = File(...)):
+    return {"form_data": form_data, "file_size": len(file)}
+
+client = TestClient(app)
+
+def test_upload_form_then_file():
+    # This should now succeed
+    response = client.post(
+        "/upload",
+        data={"form_data": "hello"},
+        files={"file": b"world"}
+    )
+    assert response.status_code == 200
+    assert response.json() == {"form_data": "hello", "file_size": 5}
+
+if __name__ == "__main__":
+    try:
+        test_upload_form_then_file()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
