--- /dev/null
+++ b/reproduce_lifespan.py
@@ -0,0 +1,37 @@
+import asyncio
+from fastapi import FastAPI, APIRouter
+from contextlib import asynccontextmanager
+
+async def test_startup():
+    print("Startup called: True")
+
+async def test_shutdown():
+    print("Shutdown called: True")
+
+@asynccontextmanager
+async def lifespan(app):
+    print("Lifespan started")
+    yield
+    print("Lifespan ended")
+
+def test_reproduction():
+    # Create an APIRouter with both lifespan and startup/shutdown handlers
+    router = APIRouter(
+        lifespan=lifespan,
+        on_startup=[test_startup],
+        on_shutdown=[test_shutdown]
+    )
+    
+    # Include the router in a FastAPI app
+    app = FastAPI()
+    app.include_router(router)
+    
+    # We can simulate this by using the lifespan context manager.
+    async def run_test():
+        async with app.router.lifespan_context(None):
+            pass
+            
+    asyncio.run(run_test())
+
+if __name__ == "__main__":
+    test_reproduction()
