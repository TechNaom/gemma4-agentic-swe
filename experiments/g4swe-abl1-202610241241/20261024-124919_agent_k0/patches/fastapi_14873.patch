--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,47 @@
+import asyncio
+from fastapi import FastAPI, APIRouter
+from fastapi.testclient import TestClient
+
+startup_called = False
+shutdown_called = False
+
+async def startup_handler():
+    global startup_called
+    startup_called = True
+
+async def shutdown_handler():
+    global shutdown_called
+    shutdown_called = True
+
+router = APIRouter(on_startup=[startup_handler], on_shutdown=[shutdown_handler])
+app = FastAPI()
+app.include_router(router)
+
+def test_lifespan():
+    global startup_called, shutdown_called
+    startup_called = False
+    shutdown_called = False
+    
+    # We need to trigger the lifespan events.
+    # In a real app, this happens when the server starts and stops.
+    # We can simulate this by using the lifespan context manager.
+    
+    async def run_test():
+        async with app.router.lifespan_context(None):
+            pass
+            
+    asyncio.run(run_test())
+    
+    print(f"Startup called: {startup_called}")
+    print(f"Shutdown called: {shutdown_called}")
+    
+    assert startup_called is True, "Startup handler was not called"
+    assert shutdown_called is True, "Shutdown handler was not called"
+
+if __name__ == "__main__":
+    try:
+        test_lifespan()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
