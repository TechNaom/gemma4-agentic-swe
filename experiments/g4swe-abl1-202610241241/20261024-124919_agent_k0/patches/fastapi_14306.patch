     TYPE_CHECKING,
@@ -149,6 +151,38 @@ def create_cloned_field(
         if isinstance(field, v2.ModelField):
             return field
 
+
+_endpoint_static_metadata_cache: Dict[Any, Dict[str, Any]] = {}
+
+
+def get_endpoint_metadata(endpoint: Any, route: Any, method: Optional[str] = None) -> Dict[str, Any]:
+    if endpoint in _endpoint_static_metadata_cache:
+        static_metadata = _endpoint_static_metadata_cache[endpoint]
+    else:
+        try:
+            filepath = inspect.getfile(endpoint)
+            lineno = inspect.getlineno(endpoint)
+            func_name = getattr(endpoint, "__name__", str(endpoint))
+            static_metadata = {
+                "filepath": filepath,
+                "lineno": lineno,
+                "func_name": func_name,
+            }
+        except Exception:
+            static_metadata = {
+                "filepath": "unknown",
+                "lineno": 0,
+                "func_name": "unknown",
+            }
+        _endpoint_static_metadata_cache[endpoint] = static_metadata
+
+    return {
+        **static_metadata,
+        "method": method,
+        "route": route,
+    }
+
+
     from fastapi._compat import v1
 
