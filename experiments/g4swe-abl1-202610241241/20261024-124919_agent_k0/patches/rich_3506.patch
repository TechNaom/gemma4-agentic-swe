+from rich.segment import Segment
+from rich.cells import cell_len
+
+def test_split():
+    text = "你好"
+    segment = Segment(text)
+    # "你好" has cell_length 4.
+    # Split at 1.
+    s1, s2 = segment.split_cells(1)
+    print(f"Text: {text}, Cut: 1")
+    print(f"S1: {repr(s1.text)}, S2: {repr(s2.text)}")
+    print(f"S1 len: {s1.cell_length}, S2 len: {s2.cell_length}")
+
+if __name__ == "__main__":
+    test_split()
