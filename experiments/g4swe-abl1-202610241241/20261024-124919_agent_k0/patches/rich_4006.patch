diff --git a/reproduce_zwj.py b/reproduce_zwj.py
new file mode 100644
index 00000000..444c8c8b
--- /dev/null
+++ b/reproduce_zwj.py
@@ -0,0 +1,24 @@
+from rich.cells import split_graphemes, cell_len
+
+def test_zwj_skipping():
+    # ZWJ followed by a character
+    text = "\u200d" + "A"
+    spans, width = split_graphemes(text)
+    print(f"Text: {repr(text)}")
+    print(f"Spans: {spans}, Width: {width}")
+    # Expected: spans should contain 'A'
+    # Current: spans is [], width is 0
+
+    text2 = "A" + "\u200d" + "B"
+    spans2, width2 = split_graphemes(text2)
+    print(f"Text: {repr(text2)}")
+    print(f"Spans: {spans2}, Width: {width2}")
+    # Expected: spans should contain 'A' and 'B' (joined or not)
+    # Current: spans is [(0, 3, 1)], width is 1 (B is skipped)
+
+    print(f"Cell len of {repr(text2)}: {cell_len(text2)}")
+    # Expected: 2
+    # Current: 1
+
+if __name__ == "__main__":
+    test_zwj_skipping()
