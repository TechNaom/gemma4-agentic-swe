@@ -0,0 +1,36 @@
+from rich.console import Console
+from rich.padding import Padding
+from rich.text import Text
+from rich.segment import Segment
+
+def test_padding_overflow():
+    console = Console(width=10)
+    # left=6, right=6, total=12 > 10
+    padding = Padding(Text("Hello"), pad=(0, 6, 0, 6), expand=False)
+    
+    # console.render returns a generator of segments
+    segments = list(console.render(padding))
+    
+    # We need to group segments into lines to check width
+    lines = []
+    current_line = []
+    for segment in segments:
+        if "\n" in segment.text and not segment.control:
+            lines.append(current_line)
+            current_line = []
+        else:
+            current_line.append(segment)
+    lines.append(current_line)
+    
+    for i, line in enumerate(lines):
+        # Calculate total width of the line
+        width = sum(len(segment.text) for segment in line if not segment.control)
+        print(f"Line {i} width: {width}")
+        assert width <= 10, f"Line {i} width {width} exceeds max_width 10"
+
+if __name__ == "__main__":
+    try:
+        test_padding_overflow()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
