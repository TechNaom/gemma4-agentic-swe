+from fastapi import FastAPI
+from fastapi.dependencies.utils import get_typed_return_annotation
+from fastapi._compat import lenient_issubclass
+from starlette.responses import Response
+import inspect
+
+def test_lenient_issubclass():
+    print(f"lenient_issubclass(None, Response): {lenient_issubclass(None, Response)}")
+    print(f"lenient_issubclass(type(None), Response): {lenient_issubclass(type(None), Response)}")
+
+def test_none_annotation():
+    def route_none() -> None:
+        return None
+    
+    def route_str_none() -> "None":
+        return None
+
+    print(f"None annotation: {get_typed_return_annotation(route_none)}")
+    print(f"Str None annotation: {get_typed_return_annotation(route_str_none)}")
+
+if __name__ == "__main__":
+    test_lenient_issubclass()
+    test_none_annotation()
