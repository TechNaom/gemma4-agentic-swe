diff --git a/debug_markdown.py b/debug_markdown.py
new file mode 100644
index 00000000..0a7a0f78
--- /dev/null
+++ b/debug_markdown.py
@@ -0,0 +1,22 @@
+from rich.console import Console
+from rich.markdown import Markdown
+
+console = Console()
+
+markdown_text = """
+| Header 1 | Header 2 |
+| --- | --- |
+| Row 1 Col 1 | Row 1 Col 2 |
+| Row 2 Col 1 | Row 2 Col 2 | Row 2 Col 3 |
+"""
+
+md = Markdown(markdown_text)
+for element in md.elements:
+    print(f"Element: {type(element)}")
+    if hasattr(element, 'header') and element.header:
+        print(f"Header cells: {[c.content for c in element.header.row.cells]}")
+    if hasattr(element, 'body') and element.body:
+        for i, row in enumerate(element.body.rows):
+            print(f"Row {i} cells: {[c.content for c in row.cells]}")
+
+console.print(md)
