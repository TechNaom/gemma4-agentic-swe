@@ -0,0 +1,12 @@
+from rich.console import Console
+from rich.text import Text
+import sys
+
+console = Console(width=20, force_terminal=True)
+text = Text("This is a long line that should wrap with a background style.", style="on blue")
+# We use a file to capture the output
+with open("output.txt", "w") as f:
+    # We need to redirect stdout to the file
+    # But Console.print writes to console.file
+    console.file = f
+    console.print(text, soft_wrap=True)
