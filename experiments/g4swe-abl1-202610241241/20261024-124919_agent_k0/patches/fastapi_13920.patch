+
+def unwrap_type_alias(annotation: Any) -> Any:
+    while is_typealiastype(annotation):
+        annotation = getattr(annotation, "__value__", annotation)
+    
+    origin = get_origin(annotation)
+    if origin is not None:
+        args = get_args(annotation)
+        if all(isinstance(arg, typing.TypeVar) for arg in args):
+            if origin is list:
+                return typing.List
+            if origin is dict:
+                return typing.Dict
+            if origin is tuple:
+                return typing.Tuple
+            return origin
+            
+    return annotation
