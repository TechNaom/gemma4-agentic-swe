diff --git a/verify_type_alias.py b/verify_type_alias.py
new file mode 100644
index 00000000..cec44097
--- /dev/null
+++ b/verify_type_alias.py
@@ -0,0 +1,114 @@
+import typing
+from typing import List, Union, Any
+from fastapi._compat.shared import (
+    unwrap_type_alias,
+    field_annotation_is_sequence,
+    field_annotation_is_complex,
+    field_annotation_is_scalar_sequence,
+    is_bytes_or_nonable_bytes_annotation,
+    is_uploadfile_or_nonable_uploadfile_annotation,
+    is_bytes_sequence_annotation,
+    is_uploadfile_sequence_annotation,
+    annotation_is_pydantic_v1,
+)
+from fastapi import UploadFile
+
+# Python 3.12 type alias
+type MyList[T] = List[T]
+type MyBytes = bytes
+type MyUploadFile = UploadFile
+type MyBytesList = List[bytes]
+type MyUploadFileList = List[UploadFile]
+
+def test_unwrap_type_alias():
+    print("Testing unwrap_type_alias...")
+    assert unwrap_type_alias(MyList) == List
+    assert unwrap_type_alias(MyBytes) == bytes
+    assert unwrap_type_alias(MyUploadFile) == UploadFile
+    assert unwrap_type_alias(MyBytesList) == List[bytes]
+    assert unwrap_type_alias(MyUploadFileList) == List[UploadFile]
+    assert unwrap_type_alias(int) == int
+    print("unwrap_type_alias passed!")
+
+def test_field_annotation_is_sequence():
+    print("Testing field_annotation_is_sequence...")
+    assert field_annotation_is_sequence(MyList[int]) is True
+    assert field_annotation_is_sequence(MyBytesList) is True
+    assert field_annotation_is_sequence(MyUploadFileList) is True
+    assert field_annotation_is_sequence(int) is False
+    print("field_annotation_is_sequence passed!")
+
+def test_field_annotation_is_complex():
+    print("Testing field_annotation_is_complex...")
+    # Complex is usually something that is not a simple scalar
+    # MyList[int] should be complex
+    assert field_annotation_is_complex(MyList[int]) is True
+    assert field_annotation_is_complex(int) is False
+    print("field_annotation_is_complex passed!")
+
+def test_field_annotation_is_scalar_sequence():
+    print("Testing field_annotation_is_scalar_sequence...")
+    assert field_annotation_is_scalar_sequence(MyBytesList) is True
+    assert field_annotation_is_scalar_sequence(MyList[int]) is True
+    assert field_annotation_is_scalar_sequence(int) is False
+    print("field_annotation_is_scalar_sequence passed!")
+
+def test_is_bytes_or_nonable_bytes_annotation():
+    print("Testing is_bytes_or_nonable_bytes_annotation...")
+    assert is_bytes_or_nonable_bytes_annotation(MyBytes) is True
+    assert is_bytes_or_nonable_bytes_annotation(bytes) is True
+    assert is_bytes_or_nonable_bytes_annotation(int) is False
+    print("is_bytes_or_nonable_bytes_annotation passed!")
+
+def test_is_uploadfile_or_nonable_uploadfile_annotation():
+    print("Testing is_uploadfile_or_nonable_uploadfile_annotation...")
+    assert is_uploadfile_or_nonable_uploadfile_annotation(MyUploadFile) is True
+    assert is_uploadfile_or_nonable_uploadfile_annotation(UploadFile) is True
+    assert is_uploadfile_or_nonable_uploadfile_annotation(int) is False
+    print("is_uploadfile_or_nonable_uploadfile_annotation passed!")
+
+def test_is_bytes_sequence_annotation():
+    print("Testing is_bytes_sequence_annotation...")
+    assert is_bytes_sequence_annotation(MyBytesList) is True
+    assert is_bytes_sequence_annotation(List[bytes]) is True
+    assert is_bytes_sequence_annotation(MyList[int]) is False
+    print("is_bytes_sequence_annotation passed!")
+
+def test_is_uploadfile_sequence_annotation():
+    print("Testing is_uploadfile_sequence_annotation...")
+    assert is_uploadfile_sequence_annotation(MyUploadFileList) is True
+    assert is_uploadfile_sequence_annotation(List[UploadFile]) is True
+    assert is_uploadfile_sequence_annotation(MyList[int]) is False
+    print("is_uploadfile_sequence_annotation passed!")
+
+def test_annotation_is_pydantic_v1():
+    print("Testing annotation_is_pydantic_v1...")
+    # We need a Pydantic v1 model for this.
+    # Since we are in a test, let's try to import it.
+    try:
+        from pydantic import v1 as pydantic_v1
+        class MyModel(pydantic_v1.BaseModel):
+            x: int
+        
+        type MyModelAlias = MyModel
+        assert annotation_is_pydantic_v1(MyModelAlias) is True
+        assert annotation_is_pydantic_v1(MyModel) is True
+        assert annotation_is_pydantic_v1(int) is False
+    except ImportError:
+        print("Pydantic v1 not available, skipping test_annotation_is_pydantic_v1")
+
+if __name__ == "__main__":
+    try:
+        test_unwrap_type_alias()
+        test_field_annotation_is_sequence()
+        test_field_annotation_is_complex()
+        test_field_annotation_is_scalar_sequence()
+        test_is_bytes_or_nonable_bytes_annotation()
+        test_is_uploadfile_or_nonable_uploadfile_annotation()
+        test_is_bytes_sequence_annotation()
+        test_is_uploadfile_sequence_annotation()
+        test_annotation_is_pydantic_v1()
+        print("\nAll tests passed!")
+    except AssertionError as e:
+        print(f"\nTest failed!")
+        raise e
