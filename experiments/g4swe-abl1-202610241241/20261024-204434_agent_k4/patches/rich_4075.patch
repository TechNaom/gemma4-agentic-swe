new file mode 100644
index 00000000..e00e4fda
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,19 @@
+from rich.console import Console
+
+console = Console(force_terminal=True)
+
+print("--- Test 1: console.print(end='END') ---")
+console.print(end="END")
+print("--- End Test 1 ---")
+
+print("\n--- Test 2: console.print(end='') ---")
+console.print(end="")
+print("--- End Test 2 ---")
+
+print("\n--- Test 3: console.print('Hello', end='END') ---")
+console.print("Hello", end="END")
+print("\n--- End Test 3 ---")
+
+print("\n--- Test 4: console.print('Hello') ---")
+console.print("Hello")
+print("--- End Test 4 ---")
