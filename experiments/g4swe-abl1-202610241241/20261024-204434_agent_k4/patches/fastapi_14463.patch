diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..af1fa000
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,53 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+from fastapi.testclient import TestClient
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+client = TestClient(app)
+
+def test_openapi_duplication():
+    openapi_schema = app.openapi()
+    responses_route1 = openapi_schema["paths"]["/route1"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]["anyOf"]
+    print(f"Number of refs in route1: {len(responses_route1)}")
+    assert len(responses_route1) == 2, f"Expected 2 refs, got {len(responses_route1)}"
+
+if __name__ == "__main__":
+    try:
+        test_openapi_duplication()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        # Print the schema to see the duplication
+        openapi_schema = app.openapi()
+        print(json.dumps(openapi_schema["paths"]["/route1"]["get"]["responses"]["500"], indent=2))
+    except Exception as e:
+        print(f"An error occurred: {e}")
