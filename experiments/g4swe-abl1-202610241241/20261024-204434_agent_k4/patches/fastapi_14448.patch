index 00000000..372b3b0d
--- /dev/null
+++ b/repro_wraps.py
@@ -0,0 +1,37 @@
+import functools
+import inspect
+import asyncio
+from starlette._utils import is_async_callable
+
+def sync_func():
+    return 1
+
+def wrapper(func):
+    @functools.wraps(func)
+    async def wrapped(*args, **kwargs):
+        return await func(*args, **kwargs) if asyncio.iscoroutinefunction(func) else func(*args, **kwargs)
+    return wrapped
+
+wrapped_sync = wrapper(sync_func)
+# wrapped_sync is an async function.
+# wrapped_sync.__wrapped__ is sync_func.
+
+print(f"wrapped_sync is async: {is_async_callable(wrapped_sync)}") # Should be True
+
+# Now let's see what happens if we have a sync wrapper around an async function.
+async def async_func():
+    return 1
+
+def sync_wrapper(func):
+    @functools.wraps(func)
+    def wrapped(*args, **kwargs):
+        # This is a sync wrapper that calls an async function. 
+        # In reality, it would need to run it in a loop, but for testing is_async_callable:
+        return func(*args, **kwargs)
+    return wrapped
+
+wrapped_async = sync_wrapper(async_func)
+# wrapped_async is a sync function.
+# wrapped_async.__wrapped__ is async_func.
+
+print(f"wrapped_async is async: {is_async_callable(wrapped_async)}") # Should be True because it wraps an async function
