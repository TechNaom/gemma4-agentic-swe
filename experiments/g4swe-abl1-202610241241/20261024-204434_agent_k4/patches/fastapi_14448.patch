new file mode 100644
index 00000000..b9c7a70a
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+import functools
+import inspect
+import asyncio
+from fastapi.routing import is_async_callable # This might not work if it's not exported
+
+# Since is_async_callable is imported from starlette._utils in routing.py, 
+# let's try to import it from there if possible, or just use the same logic.
+try:
+    from starlette._utils import is_async_callable
+except ImportError:
+    # Fallback to what starlette usually does
+    def is_async_callable(func):
+        return inspect.iscoroutinefunction(func)
+
+def sync_func():
+    return 1
+
+def wrapper(func):
+    @functools.wraps(func)
+    async def wrapped(*args, **kwargs):
+        return await func(*args, **kwargs) if asyncio.iscoroutinefunction(func) else func(*args, **kwargs)
+    return wrapped
+
+wrapped_sync = wrapper(sync_func)
+partial_wrapped_sync = functools.partial(wrapped_sync)
+
+print(f"sync_func is async: {is_async_callable(sync_func)}")
+print(f"wrapped_sync is async: {is_async_callable(wrapped_sync)}")
+print(f"partial_wrapped_sync is async: {is_async_callable(partial_wrapped_sync)}")
