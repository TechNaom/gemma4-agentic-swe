+def is_async_callable(obj: Any) -> bool:
+    current = obj
+    while True:
+        if iscoroutinefunction(current) or (callable(current) and iscoroutinefunction(getattr(current, "__call__", None))):
+            return True
+        if isinstance(current, functools.partial):
+            current = current.func
+        elif hasattr(current, "__wrapped__"):
+            current = current.__wrapped__
+        else:
+            break
+    return False
+
+
+def is_async_gen_callable(obj: Any) -> bool:
+    current = obj
+    while True:
+        if inspect.isasyncgenfunction(current) or (callable(current) and inspect.isasyncgenfunction(getattr(current, "__call__", None))):
+            return True
+        if isinstance(current, functools.partial):
+            current = current.func
+        elif hasattr(current, "__wrapped__"):
+            current = current.__wrapped__
+        else:
+            break
+    return False
+
+
+def is_gen_callable(obj: Any) -> bool:
+    current = obj
+    while True:
+        if inspect.isgeneratorfunction(current) or (callable(current) and inspect.isgeneratorfunction(getattr(current, "__call__", None))):
+            return True
+        if isinstance(current, functools.partial):
+            current = current.func
+        elif hasattr(current, "__wrapped__"):
+            current = current.__wrapped__
+        else:
+            break
+    return False
