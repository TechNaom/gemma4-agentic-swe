+@lru_cache(maxsize=128)
+def get_route_metadata(route: Any) -> str:
+    endpoint = getattr(route, \"endpoint\", None)
+    if endpoint is None:
+        return \"\"
+    try:
+        source_file = inspect.getsourcefile(endpoint)
+        line_number = inspect.getsourcelines(endpoint)[1]
+        func_name = getattr(endpoint, \"__name__\", \"unknown\")
+        method = \", \".join(route.methods) if hasattr(route, \"methods\") else \"unknown\"
+        path = getattr(route, \"path\", \"unknown\")
+        return f\" (file: {source_file}, line: {line_number}, func: {func_name}, method: {method}, path: {path})\"
+    except Exception:
+        return \"\"
 
 
