+    def __str__(self) -> str:
+        message = f\"{len(self._errors)} validation errors:\\n\"
+        for err in self._errors:
+            message += f\"  {err}\\n\"
+        if self.route:
+            message += f\"Route metadata: {get_route_metadata(self.route)}\"
+        return message.strip()
