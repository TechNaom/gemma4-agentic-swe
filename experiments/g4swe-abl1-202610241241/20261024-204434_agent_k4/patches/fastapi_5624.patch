diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..b97631bb
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,40 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import SecurityScopes
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+def dep_a():
+    return "a"
+
+def dep_b():
+    return "b"
+
+def dep_c(security_scopes: SecurityScopes):
+    return security_scopes.scopes
+
+@app.get("/")
+def root(
+    a=Security(dep_a, scopes=["scope_a"]),
+    b=Security(dep_b, scopes=["scope_b"]),
+    c=Depends(dep_c)
+):
+    return c
+
+client = TestClient(app)
+
+def test_scopes_propagation():
+    response = client.get("/")
+    # The scopes for dep_c should be the union of all scopes in the same chain.
+    # But dep_a and dep_b are in the same chain as root.
+    # Wait, the documentation says:
+    # "obtain the OAuth2 scopes required by all the dependencies in the same chain."
+    # In this case, root depends on dep_a, dep_b, and dep_c.
+    # So dep_c should see scopes from dep_a and dep_b?
+    # Let's see what happens.
+    print(f"Response: {response.json()}")
+    assert response.json() == ["scope_a", "scope_b"]
+
+if __name__ == "__main__":
+    test_scopes_propagation()
