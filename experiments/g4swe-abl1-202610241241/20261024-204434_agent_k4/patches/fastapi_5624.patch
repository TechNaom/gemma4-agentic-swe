@@ -0,0 +1,36 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import SecurityScopes
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+def dep_d2():
+    return "d2"
+
+def dep_d3():
+    return "d3"
+
+def dep_child(
+    d2=Security(dep_d2, scopes=["scope_d2"]),
+    d3=Security(dep_d3, scopes=["scope_d3"]),
+    s=SecurityScopes
+):
+    return s.scopes
+
+def dep_parent(c=Depends(dep_child)):
+    return c
+
+@app.get("/")
+def root(p=Security(dep_parent, scopes=["scope_p"])):
+    return p
+
+client = TestClient(app)
+
+def test_scopes_propagation():
+    response = client.get("/")
+    print(f"Response: {response.json()}")
+    assert response.json() == ["scope_p"]
+
+if __name__ == "__main__":
+    test_scopes_propagation()
