@@ -0,0 +1,25 @@
+from rich.pretty import _ipy_display_hook
+from rich.text import Text
+from rich import get_console
+
+# Use the global console
+console = get_console()
+
+def test_preserve_newlines():
+    # Case 1: Text with no trailing newline
+    t1 = Text("hello")
+    res1 = _ipy_display_hook(t1)
+    print(f"Test 1: {repr(t1)} -> {repr(res1)}")
+    
+    # Case 2: Text with one trailing newline
+    t2 = Text("hello\n")
+    res2 = _ipy_display_hook(t2)
+    print(f"Test 2: {repr(t2)} -> {repr(res2)}")
+    
+    # Case 3: Text with two trailing newlines
+    t3 = Text("hello\n\n")
+    res3 = _ipy_display_hook(t3)
+    print(f"Test 3: {repr(t3)} -> {repr(res3)}")
+
+if __name__ == "__main__":
+    test_preserve_newlines()
