+
+from fastapi import FastAPI, Depends, Security
+from fastapi.testclient import TestClient
+from fastapi.security import OAuth2PasswordBearer
+
+auth = OAuth2PasswordBearer(tokenUrl="token")
+
+app = FastAPI()
+
+call_count = 0
+
+def dep_b(token: str = Security(auth)):
+    global call_count
+    call_count += 1
+    return f"b-{token}"
+
+def dep_a(b=Depends(dep_b)):
+    return f"a-{b}"
+
+def dep_c(b=Depends(dep_b)):
+    return f"c-{b}"
+
+@app.get("/")
+def root(a=Depends(dep_a), c=Depends(dep_c)):
+    return f"root-{a}-{c}"
+
+client = TestClient(app)
+
+def test_dependency_caching_with_security():
+    global call_count
+    call_count = 0
+    # We need to provide a token for OAuth2PasswordBearer
+    response = client.get("/", headers={"Authorization": "Bearer token"})
+    assert response.status_code == 200
+    assert response.json() == "root-a-b-token-c-b-token"
+    assert call_count == 1, f"Expected dep_b to be called once, but it was called {call_count} times"
+
+if __name__ == "__main__":
+    try:
+        test_dependency_caching_with_security()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
