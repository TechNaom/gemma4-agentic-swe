+from fastapi import FastAPI, Depends, Security
+from httpx import AsyncClient, ASGITransport
+import asyncio
+
+app = FastAPI()
+
+async def dep_b(security_scopes=()):
+    global call_count
+    print(f"Solving dep_b with scopes {security_scopes}")
+    call_count += 1
+    return "b"
+
+async def dep_a(b = Security(dep_b, scopes=["scope1"])):
+    print("Solving dep_a")
+    return f"a-{b}"
+
+async def dep_c(b = Security(dep_b, scopes=["scope2"])):
+    print("Solving dep_c")
+    return f"c-{b}"
+
+@app.get("/")
+async def root(a = Security(dep_a, scopes=["scope1"]), c = Security(dep_c, scopes=["scope2"])):
+    print("Solving root")
+    return f"root-{a}-{c}"
+
+call_count = 0
+
+async def test_repro():
+    global call_count
+    call_count = 0
+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
+        response = await ac.get("/")
+        print(f"Requesting /\nResponse status: {response.status_code}\nResponse json: {response.json()}")
+        print(f"Call count: {call_count}")
+        assert response.json() == "root-a-b-c-b"
+        assert call_count == 2
+        print("Test passed!")
+
+if __name__ == "__main__":
+    asyncio.run(test_repro())
