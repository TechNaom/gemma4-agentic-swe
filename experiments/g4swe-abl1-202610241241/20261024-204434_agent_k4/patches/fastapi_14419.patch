+
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+from fastapi.dependencies.utils import solve_dependencies
+from fastapi.dependencies.models import Dependant
+from fastapi.types import DependencyCacheKey
+import asyncio
+
+# We need to mock the request and other things to use solve_dependencies directly,
+# or just use FastAPI and a TestClient.
+
+app = FastAPI()
+
+call_count = 0
+
+def dep_b():
+    global call_count
+    call_count += 1
+    return "b"
+
+def dep_a(b=Depends(dep_b)):
+    return f"a-{b}"
+
+def dep_c(b=Depends(dep_b)):
+    return f"c-{b}"
+
+@app.get("/")
+def root(a=Depends(dep_a), c=Depends(dep_c)):
+    return f"root-{a}-{c}"
+
+client = TestClient(app)
+
+def test_dependency_caching():
+    global call_count
+    call_count = 0
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == "root-a-b-c-b"
+    assert call_count == 1, f"Expected dep_b to be called once, but it was called {call_count} times"
+
+if __name__ == "__main__":
+    try:
+        test_dependency_caching()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
