+
+from fastapi import FastAPI, Header, HTTPException
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.get("/test")
+async def test_header(x_my_header: str = Header(convert_underscores=True)):
+    return {"x_my_header": x_my_header}
+
+client = TestClient(app)
+
+def test_underscore_header_rejected():
+    # Should be rejected (422) because convert_underscores=True
+    response = client.get("/test", headers={"x_my_header": "value"})
+    assert response.status_code == 422
+
+def test_hyphen_header_accepted():
+    # Should be accepted (200)
+    response = client.get("/test", headers={"X-My-Header": "value"})
+    assert response.status_code == 200
+    assert response.json() == {"x_my_header": "value"}
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header_rejected()
+        print("test_underscore_header_rejected passed")
+    except AssertionError as e:
+        print(f"test_underscore_header_rejected failed: {e}")
+
+    try:
+        test_hyphen_header_accepted()
+        print("test_hyphen_header_accepted passed")
+    except AssertionError as e:
+        print(f"test_hyphen_header_accepted failed: {e}")
