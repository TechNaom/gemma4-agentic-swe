+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+@app.get("/headers")
+async def read_headers(x_test_header: str = Header()):
+    return {"x_test_header": x_test_header}
+
+client = TestClient(app)
+
+def test_underscore_header():
+    # This should fail (return 422) if convert_underscores=True (default)
+    # because it should only accept 'x-test-header'
+    response = client.get("/headers", headers={"x_test_header": "test-agent"})
+    print(f"Response with x_test_header: {response.json()}")
+    assert response.status_code == 422, f"Expected 422, got {response.status_code}"
+
+def test_hyphen_header():
+    # This should succeed
+    response = client.get("/headers", headers={"x-test-header": "test-agent"})
+    print(f"Response with x-test-header: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"x_test_header": "test-agent"}
+
+def test_underscore_header_disabled():
+    # This should succeed if convert_underscores=False
+    @app.get("/headers-underscore")
+    async def read_headers_underscore(x_test_header: str = Header(convert_underscores=False)):
+        return {"x_test_header": x_test_header}
+    
+    response = client.get("/headers-underscore", headers={"x_test_header": "test-agent"})
+    print(f"Response with x_test_header (disabled): {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"x_test_header": "test-agent"}
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header()
+        print("test_underscore_header passed")
+    except AssertionError as e:
+        print(f"test_underscore_header failed: {e}")
+    
+    try:
+        test_hyphen_header()
+        print("test_hyphen_header passed")
+    except AssertionError as e:
+        print(f"test_hyphen_header failed: {e}")
+
+    try:
+        test_underscore_header_disabled()
+        print("test_underscore_header_disabled passed")
+    except AssertionError as e:
+        print(f"test_underscore_header_disabled failed: {e}")
