diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..ecab4614
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,38 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import Json
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(data: Json[List[str]] = Form(...)):
+    return {"data": data}
+
+client = TestClient(app)
+
+def test_json_list_form():
+    # This should be a JSON string representing a list of strings
+    response = client.post("/test", data={"data": '["a", "b"]'})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"data": ["a", "b"]}
+
+def test_json_list_form_invalid():
+    # This should be invalid JSON
+    response = client.post("/test", data={"data": 'not a json'})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_json_list_form()
+        print("test_json_list_form passed")
+    except Exception as e:
+        print(f"test_json_list_form failed: {e}")
+
+    try:
+        test_json_list_form_invalid()
+        print("test_json_list_form_invalid passed")
+    except Exception as e:
+        print(f"test_json_list_form_invalid failed: {e}")
