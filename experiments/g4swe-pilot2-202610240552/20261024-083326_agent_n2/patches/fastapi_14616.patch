@@ -0,0 +1,29 @@
+from fastapi import FastAPI, Form
+from pydantic import Json
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(data: Json[List[str]] = Form(...)):
+    print(f"Data type: {type(data)}, Data value: {data}")
+    return {"data": data}
+
+client = TestClient(app)
+
+def test_json_form():
+    # This should work: data is a JSON string representing a list of strings
+    response = client.post("/test", data={"data": '["abc", "def"]'})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"data": ["abc", "def"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
