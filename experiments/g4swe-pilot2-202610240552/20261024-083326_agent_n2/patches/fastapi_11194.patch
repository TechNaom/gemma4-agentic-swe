@@ -0,0 +1,30 @@
+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/test-order")
+async def test_order(form_data: str = Form(...), file: UploadFile = File(...)):
+    return {"form_data": form_data, "file": file.filename}
+
+client = TestClient(app)
+
+def test_file_after_form():
+    # This should work but according to the issue it might fail with 422
+    response = client.post(
+        "/test-order",
+        data={"form_data": "hello"},
+        files={"file": ("test.txt", b"content")}
+    )
+    print(f"Response status: {response.status_code}")
+    print(f"Response body: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_file_after_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import sys
+        sys.exit(1)
