+++ b/reproduce_issue.py
@@ -0,0 +1,29 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import Json
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(data: Json[List[str]] = Form(...)):
+    return {"data": data}
+
+client = TestClient(app)
+
+def test_json_list_form():
+    # The input is a JSON string representing a list
+    json_data = '["abc", "def"]'
+    response = client.post("/test", data={"data": json_data})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["data"] == ["abc", "def"]
+
+if __name__ == "__main__":
+    try:
+        test_json_list_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
