+from typing import Annotated, List
+from fastapi import FastAPI, Form
+from pydantic import Json
+from fastapi.testclient import TestClient
+from fastapi.dependencies.utils import _get_multidict_value
+from fastapi._compat.v2 import ModelField
+from pydantic.fields import FieldInfo
+from starlette.datastructures import ImmutableMultiDict
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Annotated[Json[List[str]], Form()]):
+    return {"data": data}
+
+def test_json_form():
+    # Simulate what FastAPI does
+    # Create a ModelField for Annotated[Json[List[str]], Form()]
+    
+    from pydantic import BaseModel
+    class Model(BaseModel):
+        data: Annotated[Json[List[str]], Form()]
+    
+    field_info = Model.model_fields['data']
+    field = ModelField(field_info=field_info, name='data')
+    
+    print(f"Field annotation: {field.field_info.annotation}")
+    
+    from fastapi._compat.v2 import is_sequence_field
+    print(f"Is sequence field: {is_sequence_field(field)}")
+    
+    values = ImmutableMultiDict([('data', '["abc", "def"]')])
+    value = _get_multidict_value(field, values)
+    print(f"Value from _get_multidict_value: {value}")
+    print(f"Value type: {type(value)}")
+
+if __name__ == "__main__":
+    test_json_form()
