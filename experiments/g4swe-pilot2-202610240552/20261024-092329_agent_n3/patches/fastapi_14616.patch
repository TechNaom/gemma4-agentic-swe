+from typing import Annotated, List
+from fastapi import FastAPI, Form
+from pydantic import Json
+from fastapi.testclient import TestClient
+from fastapi._compat.shared import field_annotation_is_sequence
+from pydantic.fields import FieldInfo
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Annotated[Json[List[str]], Form()]):
+    return {"data": data}
+
+# Let's find the field info for 'data'
+# We can get it from the app's routes
+for route in app.routes:
+    if hasattr(route, "endpoint"):
+        # This is a bit hacky but should work for this reproduction
+        # In FastAPI, the endpoint's signature is used to create the model
+        import inspect
+        sig = inspect.signature(route.endpoint)
+        print(f"Route: {route.path}, Params: {sig.parameters}")
+        for name, param in sig.parameters.items():
+            print(f"Param: {name}, Annotation: {param.annotation}")
+            # We want to see what field_annotation_is_sequence returns for this annotation
+            print(f"Is sequence: {field_annotation_is_sequence(param.annotation)}")
+
+if __name__ == "__main__":
+    # We need to make sure the app is initialized so that the routes are processed
+    # But the routes are processed when the app is created.
