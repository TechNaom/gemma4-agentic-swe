diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..f733205e
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,19 @@
+from rich.style import Style
+
+def test_clear_meta_hash():
+    style1 = Style(color="red", meta={"key": "value"})
+    style2 = style1.clear_meta_and_links()
+    
+    print(f"style1 hash: {hash(style1)}")
+    print(f"style2 hash: {hash(style2)}")
+    
+    assert hash(style1) != hash(style2), "Hash should be different after clearing meta"
+
+if __name__ == "__main__":
+    try:
+        test_clear_meta_hash()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
