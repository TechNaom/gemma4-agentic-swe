+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+@app.post("/upload")
+async def upload(form_data: str = Form(...), files: List[UploadFile] = File(...)):
+    return {"form_data": form_data, "files": [f.filename for f in files]}
+
+client = TestClient(app)
+
+def test_form_then_multiple_files():
+    response = client.post(
+        "/upload",
+        data={"form_data": "test"},
+        files={"files": [("test1.txt", b"hello"), ("test2.txt", b"world")]}
+    )
+    print(f"Response: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_form_then_multiple_files()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
