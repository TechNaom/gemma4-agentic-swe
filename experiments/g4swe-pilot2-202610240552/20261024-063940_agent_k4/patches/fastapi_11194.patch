--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,49 @@
+from fastapi import FastAPI, File, Form
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/upload-form-file")
+async def upload_form_file(name: str = Form(...), file: bytes = File(...)):
+    return {"name": name, "file_len": len(file)}
+
+@app.post("/upload-file-form")
+async def upload_file_form(file: bytes = File(...), name: str = Form(...)):
+    return {"name": name, "file_len": len(file)}
+
+client = TestClient(app)
+
+def test_upload_form_file():
+    response = client.post(
+        "/upload-form-file",
+        data={"name": "test"},
+        files={"file": ("f1", b"hello")}
+    )
+    print(f"Status code: {response.status_code}")
+    print(f"Response body: {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"name": "test", "file_len": 5}
+
+def test_upload_file_form():
+    response = client.post(
+        "/upload-file-form",
+        data={"name": "test"},
+        files={"file": ("f1", b"hello")}
+    )
+    print(f"Status code: {response.status_code}")
+    print(f"Response body: {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"name": "test", "file_len": 5}
+
+if __name__ == "__main__":
+    try:
+        test_upload_form_file()
+        print("test_upload_form_file passed")
+    except Exception as e:
+        print(f"test_upload_form_file failed: {e}")
+    
+    try:
+        test_upload_file_form()
+        print("test_upload_file_form passed")
+    except Exception as e:
+        print(f"test_upload_file_form failed: {e}")
