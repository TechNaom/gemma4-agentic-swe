+from fastapi import FastAPI, File, Form
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+@app.post("/upload-form-files")
+async def upload_form_files(name: str = Form(...), files: List[bytes] = File(...)):
+    return {"name": name, "files_len": [len(f) for f in files]}
+
+@app.post("/upload-files-form")
+async def upload_files_form(files: List[bytes] = File(...), name: str = Form(...)):
+    return {"name": name, "files_len": [len(f) for f in files]}
+
+client = TestClient(app)
+
+def test_upload_form_files():
+    response = client.post(
+        "/upload-form-files",
+        data={"name": "test"},
+        files=[("files", ("f1", b"hello")), ("files", ("f2", b"world"))]
+    )
+    print(f"Status code: {response.status_code}")
+    print(f"Response body: {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"name": "test", "files_len": [5, 5]}
+
+def test_upload_files_form():
+    response = client.post(
+        "/upload-files-form",
+        data={"name": "test"},
+        files=[("files", ("f1", b"hello")), ("files", ("f2", b"world"))]
+    )
+    print(f"Status code: {response.status_code}")
+    print(f"Response body: {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"name": "test", "files_len": [5, 5]}
+
+if __name__ == "__main__":
+    try:
+        test_upload_form_files()
+        print("test_upload_form_files passed")
+    except Exception as e:
+        print(f"test_upload_form_files failed: {e}")
+    
+    try:
+        test_upload_files_form()
+        print("test_upload_files_form passed")
+    except Exception as e:
+        print(f"test_upload_files_form failed: {e}")
