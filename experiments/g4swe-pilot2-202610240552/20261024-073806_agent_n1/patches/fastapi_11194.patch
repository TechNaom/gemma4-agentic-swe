+from fastapi import FastAPI, Form, File, UploadFile, Body
+from fastapi.testclient import TestClient
+from typing import Annotated
+
+app = FastAPI()
+
+@app.post("/form_file_body")
+async def form_file_body(
+    form_data: Annotated[str, Form(...)], 
+    file: Annotated[UploadFile, File(...)], 
+    body: Annotated[str, Body(...)]
+):
+    return {"form_data": form_data, "file": file.filename, "body": body}
+
+@app.post("/file_form_body")
+async def file_form_body(
+    file: Annotated[UploadFile, File(...)], 
+    form_data: Annotated[str, Form(...)], 
+    body: Annotated[str, Body(...)]
+):
+    return {"form_data": form_data, "file": file.filename, "body": body}
+
+client = TestClient(app)
+
+def test_form_file_body():
+    response = client.post(
+        "/form_file_body",
+        data={"form_data": "hello", "body": "world"},
+        files={"file": ("test.txt", b"content")}
+    )
+    print(f"form_file_body: {response.status_code} {response.json()}")
+
+def test_file_form_body():
+    response = client.post(
+        "/file_form_body",
+        data={"form_data": "hello", "body": "world"},
+        files={"file": ("test.txt", b"content")}
+    )
+    print(f"file_form_body: {response.status_code} {response.json()}")
+
+if __name__ == "__main__":
+    test_form_file_body()
+    test_file_form_body()
