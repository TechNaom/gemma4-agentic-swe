+from fastapi import FastAPI, Form, File, UploadFile
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/form_then_file")
+async def form_then_file(form_data: str = Form(...), file: UploadFile = File(...)):
+    return {"form_data": form_data, "file": file.filename}
+
+@app.post("/file_then_form")
+async def file_then_form(file: UploadFile = File(...), form_data: str = Form(...)):
+    return {"form_data": form_data, "file": file.filename}
+
+client = TestClient(app)
+
+def test_form_then_file():
+    response = client.post(
+        "/form_then_file",
+        data={"form_data": "hello"},
+        files={"file": ("test.txt", b"content")}
+    )
+    print(f"form_then_file: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+
+def test_file_then_form():
+    response = client.post(
+        "/file_then_form",
+        data={"form_data": "hello"},
+        files={"file": ("test.txt", b"content")}
+    )
+    print(f"file_then_form: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    test_form_then_file()
+    test_file_then_form()
