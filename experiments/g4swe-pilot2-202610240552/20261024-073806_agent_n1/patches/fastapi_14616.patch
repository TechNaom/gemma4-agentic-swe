@@ -0,0 +1,31 @@
+from fastapi import FastAPI, Form
+from pydantic import Json
+from typing import List
+from fastapi.testclient import TestClient
+from fastapi.dependencies.utils import _get_multidict_value
+from fastapi._compat import ModelField
+import pprint
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(tags: Json[List[str]] = Form()):
+    return {"tags": tags}
+
+client = TestClient(app)
+
+def test_json_form():
+    # The input is a JSON string representing a list of strings
+    json_data = '["abc", "def"]'
+    # We send it as a form field
+    response = client.post("/test", data={"tags": json_data})
+    print("Response:", response.json())
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_json_form()
+    except Exception as e:
+        print(e)
+        import traceback
+        traceback.print_exc()
