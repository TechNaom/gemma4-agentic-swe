diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..fc63b8e4
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,28 @@
+from rich.segment import Segment
+
+def test_split_cells_zero():
+    seg = Segment("A")
+    before, after = seg.split_cells(0)
+    print(f"Before: {repr(before.text)}, After: {repr(after.text)}")
+    assert before.text == ""
+    assert after.text == "A"
+
+def test_split_cells_one():
+    seg = Segment("A")
+    before, after = seg.split_cells(1)
+    print(f"Before: {repr(before.text)}, After: {repr(after.text)}")
+    assert before.text == "A"
+    assert after.text == ""
+
+if __name__ == "__main__":
+    try:
+        test_split_cells_zero()
+        print("test_split_cells_zero passed")
+    except Exception as e:
+        print(f"test_split_cells_zero failed: {e}")
+
+    try:
+        test_split_cells_one()
+        print("test_split_cells_one passed")
+    except Exception as e:
+        print(f"test_split_cells_one failed: {e}")
diff --git a/repro_bug.py b/repro_bug.py
new file mode 100644
index 00000000..c444c224
--- /dev/null
+++ b/repro_bug.py
@@ -0,0 +1,15 @@
+from rich.segment import Segment
+
+def test_split_cells_bug():
+    text = "😀" * 20
+    seg = Segment(text)
+    cut = 15
+    print(f"Text: {repr(text)}, Cut: {cut}, Cell length: {seg.cell_length}")
+    before, after = seg.split_cells(cut)
+    print(f"Before: {repr(before.text)}, After: {repr(after.text)}")
+    print(f"Before len: {len(before.text)}, After len: {len(after.text)}")
+    print(f"Before cell length: {before.cell_length}, After cell length: {after.cell_length}")
+    print(f"Total cell length: {before.cell_length + after.cell_length}")
+
+if __name__ == "__main__":
+    test_split_cells_bug()
diff --git a/repro_zero.py b/repro_zero.py
