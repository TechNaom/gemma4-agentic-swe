+++ b/repro_zero.py
@@ -0,0 +1,14 @@
+from rich.segment import Segment
+
+def test_split_cells_zero_length():
+    # \u200D is zero-width
+    seg = Segment("\u200D\u200D")
+    print(f"Text: {repr(seg.text)}, Cell length: {seg.cell_length}")
+    try:
+        before, after = seg.split_cells(0)
+        print(f"Before: {repr(before.text)}, After: {repr(after.text)}")
+    except Exception as e:
+        print(f"Caught exception: {e}")
+
+if __name__ == "__main__":
+    test_split_cells_zero_length()
