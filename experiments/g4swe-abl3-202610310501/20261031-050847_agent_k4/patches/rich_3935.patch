@@ -0,0 +1,30 @@
+from rich.console import Console, ConsoleOptions
+from rich.padding import Padding
+from rich.segment import Segment
+
+def test_padding_width_exceeds_max_width():
+    # Console width 10
+    console = Console(width=10)
+    
+    # Padding left 6, right 6. Total padding 12.
+    # This should be capped at 10.
+    p = Padding("Hello", pad=(0, 6, 0, 6))
+    
+    # We want to see what happens when max_width is 10.
+    # Padding.__rich_console__ will be called with options.max_width = 10.
+    
+    # To simulate this, we can use console.render_lines
+    lines = console.render_lines(p)
+    
+    for i, line in enumerate(lines):
+        # Calculate total width of the line
+        width = sum(len(segment.text) for segment in line)
+        print(f"Line {i} width: {width}")
+        assert width <= 10, f"Line {i} width {width} exceeds max_width 10"
+
+if __name__ == "__main__":
+    try:
+        test_padding_width_exceeds_max_width()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
