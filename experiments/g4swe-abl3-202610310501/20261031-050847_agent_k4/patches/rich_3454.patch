+
+import re
+with open('rich/highlighter.py', 'r') as f:
+    content = f.read()
+
+# Use a regex to find the URL pattern and replace it
+pattern = r'(?P<url>(file|https|http|ws|wss)://[-0-9a-zA-Z$_+!`(),.?/;:&=%#~]*)'
+replacement = r'(?P<url>(file|https|http|ws|wss)://[-0-9a-zA-Z$_+!`(),.?/;:&=%#~@]*)'
+
+# We need to be careful not to replace other things.
+# The line is: r"(?P<url>(file|https|http|ws|wss)://[-0-9a-zA-Z$_+!`(),.?/;:&=%#~]*)\",
+# Let's just replace the specific character set.
+
+content = content.replace('[-0-9a-zA-Z$_+!`(),.?/;:&=%#~]*]', '[-0-9a-zA-Z$_+!`(),.?/;:&=%#~@]*]')
+# Wait, the original was [-0-9a-zA-Z$_+!`(),.?/;:&=%#~]*
+# Let's just use a simple string replace for the character set.
+
+content = content.replace('[-0-9a-zA-Z$_+!`(),.?/;:&=%#~]*)', '[-0-9a-zA-Z$_+!`(),.?/;:&=%#~@]*)')
+
+with open('rich/highlighter.py', 'w') as f:
+    f.write(content)
