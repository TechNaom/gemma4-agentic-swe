--- /dev/null
+++ b/repro_styles.py
@@ -0,0 +1,16 @@
+from rich.console import Console
+from rich.text import Text
+
+console = Console(width=20, force_terminal=True)
+text = Text.assemble("This is a ", Text("long line of text", style="on blue"), " with a background style")
+
+with console.capture() as capture_false:
+    console.print(text, soft_wrap=False)
+output_false = capture_false.get()
+
+with console.capture() as capture_true:
+    console.print(text, soft_wrap=True)
+output_true = capture_true.get()
+
+print(f"False: {repr(output_false)}")
+print(f"True: {repr(output_true)}")
