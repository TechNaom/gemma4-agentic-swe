@@ -0,0 +1,18 @@
+from rich.markup import render
+from rich.errors import MarkupError
+
+test_cases = [
+    "test" + "\\",
+    "test" + "\\\\",
+    r"test\\[bold]text[/bold]",
+    r"test\[bold]text[/bold]",
+    r"test\\[bold]text",
+    r"test\\[bold]",
+]
+
+for tc in test_cases:
+    try:
+        res = render(tc)
+        print(f"Input: {tc!r} -> Output: {res} Spans: {res.spans}")
+    except MarkupError as e:
+        print(f"Input: {tc!r} -> MarkupError: {e}")
